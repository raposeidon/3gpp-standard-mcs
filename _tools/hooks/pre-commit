#!/usr/bin/env python3
"""스테이징된 파일 중 .gitignore 가 제외하는 것이 있으면 커밋을 거부한다.

.gitignore 는 허용 목록이라 정상 경로로는 원문이 스테이징되지 않는다. 남는 구멍은
git add -f 뿐이므로, 추가 · 수정된 파일을 git check-ignore 로 .gitignore 에 다시
대 본다. 기준을 .gitignore 하나에 두어 확장자 목록을 따로 관리하지 않는다.

설치 (클론마다 한 번): git config core.hooksPath _tools/hooks
"""
import subprocess
import sys


def git(*args, stdin=None):
    return subprocess.run(["git", *args], input=stdin, capture_output=True, check=False)


def main():
    # 삭제는 대상이 아니다 - 실수로 들어간 원문을 지우는 커밋은 통과해야 한다
    staged = git("diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR").stdout
    if not staged:
        return 0
    r = git("check-ignore", "--no-index", "-z", "--stdin", stdin=staged)
    if r.returncode not in (0, 1):
        sys.stderr.write(r.stderr.decode("utf-8", "replace"))
        return 1
    bad = [p for p in r.stdout.decode("utf-8", "replace").split("\0") if p]
    if not bad:
        return 0
    sys.stderr.write(f"커밋 거부: .gitignore 가 제외하는 파일 {len(bad)}개가 스테이징됐다 "
                     "(3GPP · ITU-T 원문은 재배포 불가).\n")
    for p in bad[:20]:
        sys.stderr.write(f"  {p}\n")
    if len(bad) > 20:
        sys.stderr.write(f"  ... 외 {len(bad) - 20}개\n")
    sys.stderr.write("빼려면: git restore --staged <경로>\n")
    return 1


if __name__ == "__main__":
    sys.exit(main())
