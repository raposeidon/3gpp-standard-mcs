#!/bin/sh
""":"
# sh 와 Python 이 함께 읽는 머리 - sh 는 여기서 Python 3 을 찾아 이 파일을 다시 실행하고,
# Python 에는 이 구간이 문자열일 뿐이다. 이름을 python3 하나로 박지 않는 이유는
# python.org 판 Windows 에는 python.exe 만 있어 python3 가 WindowsApps 스텁이나 다른 배포판
# (MSYS2 등) 으로 잡히기 때문이다. 이름마다 실제로 Python 3 이 뜨는지 확인하고 쓴다.
for py in python python3 py; do
    "$py" -c 'import sys; sys.exit(sys.version_info < (3, 8))' >/dev/null 2>&1 \
        && exec "$py" "$0" "$@"
done
echo "pre-commit: Python 3 을 찾지 못했다 (python · python3 · py)" >&2
exit 1
":"""
"""스테이징된 파일 중 .gitignore 가 제외하는 것이 있으면 커밋을 거부한다.

.gitignore 는 허용 목록이라 정상 경로로는 원문이 스테이징되지 않는다. 남는 구멍은
git add -f 뿐이므로, 추가 · 수정된 파일을 .gitignore 에 다시 대 본다. 기준을 .gitignore
하나에 두어 확장자 목록을 따로 관리하지 않는다. 대는 쪽은 작업 트리가 아니라
스테이징된 .gitignore 다 - 커밋될 규칙으로 판정해야 하기 때문이다 (최상위 파일만 본다).

설치 (클론마다 한 번): git config core.hooksPath _tools/hooks
"""
import subprocess
import sys
import tempfile
from pathlib import Path


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, check=False)


def main():
    # 삭제는 대상이 아니다 - 실수로 들어간 원문을 지우는 커밋은 통과해야 한다
    out = git("diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR").stdout
    staged = {p for p in out.decode("utf-8", "replace").split("\0") if p}
    if not staged:
        return 0
    rules = git("show", ":.gitignore")
    if rules.returncode != 0:  # 스테이징된 .gitignore 가 없으면 제외 규칙도 없다
        return 0
    with tempfile.TemporaryDirectory() as tmp:
        rules_file = Path(tmp) / "gitignore"
        rules_file.write_bytes(rules.stdout)
        r = git("ls-files", "--cached", "--ignored", f"--exclude-from={rules_file}", "-z")
    if r.returncode != 0:
        sys.stderr.write(r.stderr.decode("utf-8", "replace"))
        return 1
    ignored = {p for p in r.stdout.decode("utf-8", "replace").split("\0") if p}
    bad = sorted(staged & ignored)
    if not bad:
        return 0
    sys.stderr.write(f"커밋 거부: .gitignore 가 제외하는 파일 {len(bad)}개가 스테이징됐다 "
                     "(3GPP · ITU-T 원문은 재배포 불가).\n")
    for p in bad[:20]:
        sys.stderr.write(f"  {p}\n")
    if len(bad) > 20:
        sys.stderr.write(f"  ... 외 {len(bad) - 20}개\n")
    sys.stderr.write("빼려면: git restore --staged <경로>\n")
    return 1


if __name__ == "__main__":
    sys.exit(main())
